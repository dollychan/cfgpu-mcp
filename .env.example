# Required
CFGPU_API_TOKEN=your_api_token_here

# Required only when providers.cfgpu-daily is enabled in config.yaml
# (the test-phase home of MiniMax-H3). Not the same credential as
# CFGPU_API_TOKEN — daily is a separate host, and load_settings refuses to point
# a non-cfgpu provider at the production token.
CFGPU_DAILY_API_TOKEN=your_cfgpu_daily_api_token_here

# Optional
CFGPU_BASE_URL=https://www.cfgpu.com/userapi/v1
CFGPU_DB_PATH=~/.cfgpu/tasks.db

# Comma-separated list of adapter_id or cfgpu_model_id to enable (default: all)
# CFGPU_ENABLED_MODELS=wan-2.0,wan-2.0-fast,doubao-seedream-5-0-lite
